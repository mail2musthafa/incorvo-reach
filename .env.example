# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Application
APP_NAME="Incorvo Reach"
APP_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Tokens
SECRET_KEY=incorvo_reach_super_secret_jwt_key_development_only_2026_x99
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL / SQLite async for local dev)
DATABASE_URL=postgresql+asyncpg://incorvo_user:incorvo_secure_pass_2026@localhost:5432/incorvo_reach
# SQLite async fallback for rapid offline testing:
# DATABASE_URL=sqlite+aiosqlite:///./incorvo_reach.db

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# Storage / S3 Mock
STORAGE_PROVIDER=mock
STORAGE_BUCKET_NAME=incorvo-reach-assets

# Parent Company
PARENT_COMPANY="Quenix Analytics Private Limited"
